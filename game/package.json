{
  "name": "bardia",
  "version": "0.1.0",
  "description": "Bardia: a single-player saga-strategy RPG of the Vendel-period North.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "sim": "tsx tools/sim-cli.ts",
    "tool": "tsx tools/run.ts",
    "verify:module": "tsx tools/verify-module/index.ts",
    "perf": "tsx tools/perf/index.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "fflate": "0.8.3",
    "howler": "2.2.4",
    "immer": "11.2.9",
    "intl-messageformat": "12.1.4",
    "pixi.js": "8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/howler": "2.2.13",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "fast-xml-parser": "5.11.2",
    "jsdom": "30.1.3",
    "pngjs": "7.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
